# Copia este archivo a ".env" y completa los valores. No subas ".env" a Git ni lo entregues.
AIRFLOW_UID=50000

# Clave Fernet: genera una con el comando del README (sin espacios ni comillas).
FERNET_KEY=pega_aqui_la_clave_fernet

# Base de datos PostgreSQL donde se carga Gold.
DW_NAME=desercion_dw
DW_USER=desercion
DW_PASSWORD=cambia_esta_clave
